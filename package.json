{
  "name": "kingdom-hearts-localization-tool",
  "productName": "KINGDOM HEARTS LOCALIZATION TOOL",
  "version": "1.1.0",
  "description": "Набір інструментів для локалізації ігор серії Kingdom Hearts: текст, шрифти й текстури",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "Dmytro Bidlov",
    "url": "https://github.com/LittleBitUA"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run test:smoke",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win portable nsis",
    "extract": "node tools/diff-extract.js",
    "extract:batch": "node tools/batch-extract.js",
    "compose": "node tools/diff-build.js",
    "test:smoke": "node scripts/smoke.js",
    "patcher:build": "node tools/patcher/build.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.2"
  },
  "build": {
    "appId": "com.littlebit.kingdom-hearts-localization-tool",
    "productName": "KINGDOM HEARTS LOCALIZATION TOOL",
    "copyright": "Copyright © 2026 Dmytro Bidlov «Little Bit» Team",
    "publish": [
      {
        "provider": "github",
        "owner": "LittleBitUA",
        "repo": "KINGDOM-HEARTS-LOCALIZATION-TOOL"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "workers/**/*",
      "shared/**/*",
      "data/**/*",
      "renderer/**/*",
      "tools/lib/**/*",
      "assets/**/*",
      "tools/py/**/*",
      "package.json",
      "!**/.DS_Store",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/*.{md,markdown}",
      "!**/.{eslintrc,eslintignore,prettierrc,editorconfig,gitignore,gitattributes}"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KingdomHearts-Localization-Tool-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "KingdomHearts-Localization-Tool-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KINGDOM HEARTS LOCALIZATION TOOL",
      "installerLanguages": [
        "uk_UA",
        "en_US"
      ],
      "language": "1058",
      "artifactName": "KingdomHearts-Localization-Tool-${version}-setup.exe"
    },
    "asarUnpack": [
      "tools/py/**/*",
      "assets/fonts/**/*"
    ]
  }
}
